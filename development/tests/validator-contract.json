    "DECISION_SUPERSESSION_MISSING",
    "DECISION_SUPERSESSION_STATUS",
    "DIRECTORY_UNREADABLE",
    "FILE_BOM_FORBIDDEN",
    "FILE_CHANGED_DURING_READ",
    "FILE_LINE_ENDING_INVALID",
    "FILE_UNREADABLE",
