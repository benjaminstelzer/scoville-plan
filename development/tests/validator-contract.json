{
  "schema_version": 1,
  "command": "python scoville-plan/scripts/validate_profile.py --root <project-root> --format json",
  "result_fields": [
    "schema_version",
    "valid",
    "root",
    "format_version",
    "summary",
    "diagnostics"
  ],
  "summary_fields": [
    "errors",
    "warnings",
    "files_checked",
    "plans",
    "work_items",
    "decisions"
  ],
  "diagnostic_fields": [
    "code",
    "severity",
    "file",
    "line",
    "record",
    "field",
    "message",
    "expected",
    "observed",
    "suggestion",
    "related"
  ],
  "severities": ["error", "warning"],
  "exit_codes": {
    "0": {"valid": true, "meaning": "complete inspection found no structural error"},
    "1": {"valid": false, "meaning": "complete inspection found one or more structural errors"},
    "2": {"valid": null, "meaning": "the requested profile could not be inspected completely"},
    "3": {"valid": null, "meaning": "the validator itself failed"}
  },
  "sort_key": [
    "file",
    "line_is_absent",
    "line_or_zero",
    "record_or_empty",
    "field_or_empty",
    "code",
    "canonical_observed",
    "message"
  ],
  "proof_limits": [
    "human authorization",
    "decision quality",
    "evidence truth",
    "acceptance sufficiency",
    "reported work occurrence",
    "recomputation of Decision batch hashes from unavailable pre-mutation bytes"
  ],
  "diagnostic_codes": [
    "DATE_INVALID",
    "DATE_ORDER_INVALID",
    "DECISION_ACCEPTED_FORBIDDEN",
    "DECISION_ACCEPTED_REQUIRED",
    "DECISION_BATCH_ASYMMETRIC",
