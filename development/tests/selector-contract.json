{
  "schema_version": 1,
  "command": "python scoville-plan/scripts/select_context.py --root <project-root> [--work-item W-001] --format json",
  "success_top_level_fields": [
    "plan",
    "work_item",
    "direct_dependencies",
    "decisions"
  ],
  "plan_fields": [
    "frontmatter",
    "goal",
    "non_goals"
  ],
  "excluded_success_content": [
    "unrelated Work Item bodies",
    "unreferenced Decision bodies",
    "proposal inventory",
    "graph inventory",
    "raw full-file fallback"
  ],
  "failure_behavior": [
    "structured diagnostic",
    "no partial context",
    "no truncation",
    "no source mutation"
  ]
}
